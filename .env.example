PORT=3000
MODE=localhost|development|staging|production
NAME=your-app-name

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password
DB_DATABASE=your-database-name

ENCRYPTION_SALT=your-salt-string
EXPIRED_AUTH_TOKEN=5 #active auth for 5 days
EXPIRED_CODE_TOKEN=30 #active code for 30 minutes

AXIOM_IS_ACTIVE=false
AXIOM_DATASET=axiom-dataset-name
AXIOM_API_KEY=axiom-token-or-api-key
LOG_LEVEL=silent|info|trace|debug|warn|error|fatal #follow information about log level https://github.com/pinojs/pino/blob/main/docs/api.md

SUPERADMIN_FIRST_NAME= #REQUIRED
SUPERADMIN_MIDDLE_NAME= #OPTIONAL
SUPERADMIN_LAST_NAME= #OPTIONAL
SUPERADMIN_EMAIL= #REQUIRED | UNIQUE (DON NOT SAME WITH ADMIN)
ADMIN_FIRST_NAME= #REQUIRED
ADMIN_MIDDLE_NAME= #OPTIONAL
ADMIN_LAST_NAME= #OPTIONAL
ADMIN_EMAIL= #REQUIRED | UNIQUE (DON NOT SAME WITH SUPERADMIN)
DEFAULT_PASSWORD="wh4t 3VeR u W4nT!"
